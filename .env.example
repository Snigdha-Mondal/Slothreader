# Slothreader Environment Configuration
# Copy this file to .env and adjust values as needed.

# Sentry Agent Tracing DSN (Optional for local testing; telemetry is mocked safely if omitted)
SENTRY_DSN=""

# Local Ollama Host & Model
OLLAMA_HOST="http://localhost:11434"
GEMMA_MODEL="gemma2:2b"

# Live IMAP Configuration (Only required when using --live mode; NOT needed for --demo mode)
IMAP_SERVER="imap.gmail.com"
IMAP_PORT="993"
IMAP_USERNAME="your-email@example.com"
IMAP_PASSWORD="your-app-specific-password"
IMAP_FOLDER="Newsletters"
